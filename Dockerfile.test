# Se usa imagen basada en Debian/Ubuntu para compatibilidad completa con navegadores (Chrome/Chromium y Cypress)
FROM node:22-bookworm-slim

# Evitar prompts interactivos durante la instalación de paquetes
ENV DEBIAN_FRONTEND=noninteractive

# Instalar dependencias del sistema requeridas para Chromium, Cypress y tests headless
RUN apt-get update && apt-get install -y --no-install-recommends \
  chromium \
  libgtk2.0-0 \
  libgtk-3-0 \
  libgbm-dev \
  libnotify-dev \
  libgconf-2-4 \
  libnss3 \
  libxss1 \
  libasound2 \
  libxtst6 \
  xauth \
  xvfb \
  ca-certificates \
  && rm -rf /var/lib/apt/lists/*

# Configurar variable para que Karma/Angular apunte al Chromium del contenedor
ENV CHROME_BIN=/usr/bin/chromium

# Habilitar pnpm mediante Corepack
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app

# Copiar manifiestos de dependencias
COPY package.json pnpm-lock.yaml* ./

# Instalar TODAS las dependencias (incluyendo devDependencies para pruebas)
RUN npm install --legacy-peer-deps

# Copiar el código fuente completo del proyecto
COPY . .

# Comando por defecto: ejecuta las pruebas unitarias en modo headless (una sola corrida)
CMD ["npm", "run", "test", "--", "--watch=false"]
